<Window x:Class="SimpinkNative.Windows.DownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloading FFmpeg..." Height="150" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#1A1A1A" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Text="Starting download..." Grid.Row="0" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
        
        <ProgressBar x:Name="ProgressBar" Grid.Row="1" Height="20" Minimum="0" Maximum="100" />
        
        <TextBlock x:Name="ProgressText" Text="0%" Grid.Row="2" Foreground="#AAAAAA" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Right"/>
    </Grid>
</Window>
